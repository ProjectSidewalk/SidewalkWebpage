dashboard.settings.username.error.charset = Gebruik alleen letters, cijfers, koppeltekens en underscores.
dashboard.settings.username.error.allowed = Die gebruikersnaam is niet toegestaan — kies een andere.
dashboard.settings.username.error.taken = Die gebruikersnaam is al in gebruik.
dashboard.settings.email = E-mail
dashboard.settings.email.help = Wordt gebruikt om in te loggen en je wachtwoord te herstellen. Mail naar <a href="mailto:sidewalk@cs.uw.edu">sidewalk@cs.uw.edu</a> om je e-mailadres te wijzigen.
dashboard.settings.units = Maateenheden
dashboard.settings.units.auto = Standaard
dashboard.settings.units.metric = Kilometers & meters
dashboard.settings.units.imperial = Mijlen & voet
dashboard.settings.units.help = Afstanden op de hele site gebruiken deze eenheden. Laat het op "Standaard" staan om de maateenheden van de taal van de site te gebruiken.
dashboard.settings.service.hours = Vrijwilligersuren
dashboard.settings.service.hours.toggle = Aanmelden voor maatschappelijke serviceuren
dashboard.settings.service.hours.help = Meldt je aan voor officiële erkenning — je begeleider kan je uren verifiëren — en voegt "Serviceuren" en "Tijdcontrole" toe aan je accountmenu.
dashboard.settings.service.hours.link = Hoe serviceuren werken
dashboard.settings.team = Team
dashboard.settings.team.label = Je team
dashboard.settings.team.none = Geen team
dashboard.settings.team.help = Sluit je aan bij een team of klas om samen in kaart te brengen en op het teamscoreboard te verschijnen. Kies "Geen team" om je huidige team te verlaten.
dashboard.settings.privacy = Privacy
dashboard.settings.privacy.default.note = Deze omgeving houdt profielen standaard privé. Zet deze opties aan als je je naam en voortgang met de gemeenschap wilt delen.
dashboard.settings.leaderboard.toggle = Toon mij op het scoreboard
dashboard.settings.leaderboard.help = Als dit uit staat, verschijnt je naam in geen enkele ranglijst.
dashboard.settings.public.toggle = Maak mijn dashboard openbaar
dashboard.settings.public.help = Als dit aan staat, kan iedereen op je naam op het scoreboard klikken en een openbare versie van je dashboard zien (je statistieken, badges en trofeeën — nooit je e-mailadres). Als dit uit staat, wordt je profiel als "privé" weergegeven.
dashboard.settings.save = Wijzigingen opslaan
dashboard.profile.tag = Openbaar profiel
dashboard.profile.headline = {0} heeft in {2} <strong>{1} labels</strong> geplaatst en maakt stoepen daarmee toegankelijker.
dashboard.profile.map.caption = Waar deze persoon is geweest — de verkende straten en labels van {0}. Open de legenda om te filteren.
dashboard.profile.notfound.title = Deelnemer niet gevonden
dashboard.profile.notfound = We konden niemand vinden met de naam "{0}".
dashboard.profile.notfound.detail = De naam is misschien veranderd. Ga terug naar het <a href="{0}">scoreboard</a> om diegene te vinden.
dashboard.profile.private = {0} houdt het profiel privé.
dashboard.profile.private.detail = Diegene is nog steeds bezig stoepen toegankelijker te maken — er is alleen voor gekozen geen openbaar profiel te delen.
dashboard.profile.trophy.none = 🏆 {0} heeft nog geen trofeeën verdiend — maar elk label telt.
leaderboard.intro = Elk label maakt stoepen toegankelijker en veiliger voor iedereen. Zo doet de gemeenschap het.
leaderboard.intro.you = Elk label maakt stoepen toegankelijker en veiliger voor iedereen. Zo doen de gemeenschap — en jij — het.
leaderboard.cta.title = Wil je zien waar je staat?
leaderboard.cta.detail = Maak een gratis account aan om je labels bij te houden, badges en trofeeën te verdienen en te stijgen op het bord.
leaderboard.cta.signup = Account aanmaken
leaderboard.hero.caption = {0} tot nu toe
leaderboard.hero.bridge = In alle {0} Project Sidewalk-steden samen heeft de gemeenschap {1} labels en {2} validaties bijgedragen.
leaderboard.hero.bridge.link = Bekijk de impact van de gemeenschap
leaderboard.hero.streets.detail = Elke straat telt één keer mee, hoeveel mensen die ook hebben verkend. Het cijfer voor alle steden hieronder telt elke verkenning apart.
leaderboard.podium.title = Bovenaan het bord
leaderboard.podium.intro = De koplopers aller tijden van {0}. 🏆
leaderboard.podium.labels = {0} labels
leaderboard.podium.none = 🌱 Het bord begint net — wees een van de eersten bovenaan. Begin met in kaart brengen!
leaderboard.alltime.title = {0} aller tijden
leaderboard.alltime.intro = De actiefste deelnemers aller tijden in {0}, gerangschikt op totaalscore.
leaderboard.alltime.none = 🌱 Nog geen labels — jij zou de allereerste naam hier kunnen zijn.
leaderboard.explainer.summary = Hoe wordt de ranglijst berekend?
leaderboard.explainer.body = De rangschikking is een totaal-<strong>score</strong> die een balans beloont van <strong>geplaatste labels</strong>, <strong>verkende afstand</strong> en <strong>labelnauwkeurigheid</strong> — gestaag, kwalitatief in kaart brengen telt dus zwaarder dan puur volume. Daarom staan de labelaantallen hieronder niet strikt op volgorde. (Het week- en teambord gebruiken dezelfde score.)
leaderboard.header.mapper = Deelnemer
leaderboard.accuracy.explain = Zo wordt nauwkeurigheid berekend:
leaderboard.accuracy.detail = Het aandeel gevalideerde labels van een deelnemer waarvan anderen bevestigden dat ze juist waren. Wordt getoond zodra iemand minstens 10 gevalideerde labels heeft.
leaderboard.thisweek.title = {0} deze week
leaderboard.thisweek.intro = Elke maandag vers — de beste plek om snel te klimmen.
leaderboard.thisweek.none = ✨ Nog geen labels deze week — wees de eerste op het bord!
leaderboard.teams.title = Teams in {0}
leaderboard.teams.intro = Maak een team aan of sluit je aan om samen het verschil te maken!
leaderboard.teams.none = 👥 Nog geen teams — wees de eerste! Maak er een aan en nodig vrienden of klasgenoten uit.
leaderboard.allcities.title = Alle steden, aller tijden
leaderboard.allcities.intro = De beste deelnemers uit alle Project Sidewalk-steden, gerangschikt op het totale aantal labels.
leaderboard.allcities.note = De afstand wordt één keer per dag bijgewerkt.
leaderboard.allcities.none = 🌍 Nog geen labels in de steden — die van jou kan de eerste zijn.
leaderboard.header.topcity = Topstad
leaderboard.you.title = Jouw plek in {0} deze week
leaderboard.you.intro = Waar je staat tussen de deelnemers van deze week, en wie net voor en achter je zit.
